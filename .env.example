# ===================================================================
# TRANSIT SENSE - SECURE ENVIRONMENT CONFIGURATION TEMPLATE
# DevSecOps Hardening: No plain-text production keys or credentials.
# Copy this file to .env and provide your deployment secrets.
# ===================================================================

# Environment
NODE_ENV=production
PORT=8080
API_BASE_URL=https://gateway.transitsense.gov.in

# Strict CORS Trusted Origins (No wildcards)
CORS_ORIGIN=https://transitsense.gov.in,https://iccc.transitsense.gov.in

# Redis Cache & Rate Limiting (100 req/min/IP)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication (JWT Secret with short expiration & HttpOnly cookies)
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_KEY_3948572093845
JWT_EXPIRES_IN=15m
COOKIE_SECRET=CHANGE_ME_SECURE_COOKIE_SECRET_HERE

# Database (PostgreSQL + PostGIS for spatial queries)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=transitsense_db
DB_USER=transitsense_app
DB_PASSWORD=YOUR_SECURE_POSTGRESQL_PASSWORD_HERE

# Edge RTSP Camera Streams (Masked by Backend Gateway Proxy)
MUM_WEH_RTSP_URL=rtsp://mum-weh-internal-ip:554/live/stream1
BLR_SILKBOARD_RTSP_URL=rtsp://blr-silkboard-internal-ip:554/live/stream1
DEL_DND_RTSP_URL=rtsp://delhi-dnd-internal-ip:554/feed1
HYD_CYBER_RTSP_URL=rtsp://hyd-cyber-internal-ip:554/main
CHN_KATHIPARA_RTSP_URL=rtsp://chn-kathipara-internal-ip:554/live

# NVIDIA TensorRT YOLOv11 Inference Engine
TENSORRT_MODEL_PATH=/opt/models/yolov11x_traffic_int8.engine
BYTE_TRACK_CONFIG_PATH=/opt/configs/bytetrack_indian_traffic.yaml
INFERENCE_BATCH_SIZE=4
INFERENCE_PRECISION=INT8
